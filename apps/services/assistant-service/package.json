{
  "name": "@orbit/assistant-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Orbit assistant-service — RAG chat API (hybrid BM25 + pgvector retrieval, Anthropic answers)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src eval",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "eval": "tsx eval/run-eval.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^0.3.26",
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.66",
    "@langchain/openai": "^0.6.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@orbit/shared": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
