{
  "name": "@orbit/registry-service",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Orbit registry-service: Confluence ingestion + registry API (NestJS)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@orbit/shared": "workspace:*",
    "axios": "^1.12.0",
    "cheerio": "^1.1.0",
    "cron": "^4.3.0",
    "domhandler": "^5.0.3",
    "drizzle-orm": "^0.44.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "@swc/core": "^1.10.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.4"
  }
}
