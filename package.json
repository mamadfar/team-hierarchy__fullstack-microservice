{
  "name": "orbit-monorepo",
  "private": true,
  "version": "0.2.4",
  "description": "Orbit — Team Atlas: team discovery + ticket-routing app (Next.js + NestJS microservices)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r run test:integration",
    "eval": "pnpm --filter @orbit/assistant-service run eval",
    "db:migrate": "pnpm --filter @orbit/registry-service run db:migrate",
    "db:seed": "pnpm --filter @orbit/registry-service run db:seed"
  }
}
