# ============================================================
# Orbit — env contract. Copy to .env and fill. Never commit .env.
# Validated at boot (zod) by each service; missing vars fail fast.
# ============================================================

# --- shared infra ---
# dev infra (docker-compose.dev.yml) publishes on 5433/6380 to avoid clashing
# with other local stacks that already hold 5432/6379
DATABASE_URL=postgres://orbit:orbit@localhost:5433/orbit
REDIS_URL=redis://localhost:6380

# --- Confluence (registry-service) — see docs/CONFLUENCE_SETUP.md ---
CONFLUENCE_BASE_URL=            # https://<org>.atlassian.net/wiki
CONFLUENCE_EMAIL=               # service account, e.g. svc-orbit@company.com
CONFLUENCE_API_TOKEN=           # secret — never commit
CONFLUENCE_PAGE_IDS=            # comma-separated page ids, order = display order
MOCK_CONFLUENCE=true            # true = ingest from infra/db/seed fixtures (default dev/CI)
SYNC_CRON=                      # optional cron, e.g. "0 * * * *" (empty = off)
SYNC_APP_TOKEN=dev-sync-token   # bearer token required by POST /sync
GROUP_NAME=Aurora Group         # root org shown in the Hierarchy view
GROUP_ICON=globe
GROUP_HUE=262

# --- assistant-service (RAG) ---
ANTHROPIC_API_KEY=              # secret — required for real chat answers
LLM_MODEL=claude-haiku-4-5
EMBEDDING_PROVIDER=mock         # mock | voyage | openai (mock = deterministic, offline)
EMBEDDING_MODEL=voyage-3-lite
EMBEDDING_API_KEY=              # secret — key for the chosen embedding provider

# --- service ports & CORS ---
REGISTRY_PORT=4001
ASSISTANT_PORT=4002
WEB_ORIGIN=http://localhost:3000

# --- web (public — safe to expose to the browser) ---
NEXT_PUBLIC_REGISTRY_API_URL=http://localhost:4001
NEXT_PUBLIC_ASSISTANT_API_URL=http://localhost:4002
NEXT_PUBLIC_TICKET_URL_TEMPLATE=https://jira.company.com/secure/CreateIssue.jspa?pid={queueKey}
